# 安心用药 · 环境变量示例（复制为 .env 后填真实值；.env 已 gitignore，勿提交真实凭据）

# ── PostgreSQL ──
# dev 库连接。测试库 anxin_medication_test 由此 URL 派生（仅换库名），
# 需 anxin 角色具备 CREATEDB 权限（T6 测试库基建）：ALTER ROLE anxin CREATEDB;
DATABASE_URL=postgresql://anxin:anxin_dev_2026@localhost:5432/anxin_medication

# ── Qwen3-VL（层检测 / 身份线提取；key 只在后端）──
QWEN_API_KEY=
QWEN_BASE_URL=

# ── 咨询文本链（P0 · docs/13 §3/§5.1：默认 qwen3.8-flash 非思考；deepseek 对照；baichuan 回滚）──
# CONSULT_PROVIDER: qwen | deepseek | baichuan；思考开关在客户端代码写死（R4），不设 env
CONSULT_PROVIDER=qwen
# 仅作用于 qwen 文本链的模型覆盖（缺省 qwen3.8-flash；deepseek 用 DEEPSEEK_MODEL）
CONSULT_MODEL=
# DeepSeek 对照档（仅 CONSULT_PROVIDER=deepseek 时 consultAnswer 走此链；fallbackParse/摘要仍走 qwen）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# ── Baichuan-M3-Plus（回滚通道：CONSULT_PROVIDER=baichuan 时启用；P0 前的默认咨询引擎）──
BAICHUAN_API_KEY=
BAICHUAN_BASE_URL=

# ── OCR（医嘱线；qwen3.5-ocr 云端 OpenAI 兼容端点，ADR #16 取代 #13 弃 PaddleOCR 自托管）──
# OCR_BASE_URL 为 OpenAI 兼容 base（如 https://dashscope.aliyuncs.com/compatible-mode/v1），
# 实际调用 POST {OCR_BASE_URL}/chat/completions；OCR_MODEL 默认 qwen3.5-ocr。
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=qwen3.5-ocr

# ── 其他开关 ──
# 运行端口（默认 8787）
PORT=8787
