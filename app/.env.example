# 安心用药 · 环境变量示例（复制为 .env 后填真实值；.env 已 gitignore，勿提交真实凭据）

# ── PostgreSQL ──
# dev 库连接。测试库 anxin_medication_test 由此 URL 派生（仅换库名），
# 需 anxin 角色具备 CREATEDB 权限（T6 测试库基建）：ALTER ROLE anxin CREATEDB;
DATABASE_URL=postgresql://anxin:anxin_dev_2026@localhost:5432/anxin_medication

# ── Qwen3-VL（层检测 / 身份线提取；key 只在后端）──
QWEN_API_KEY=
QWEN_BASE_URL=

# ── Baichuan-M3-Plus（医嘱兜底解析 / 咨询 / 医生端摘要）──
BAICHUAN_API_KEY=
BAICHUAN_BASE_URL=

# ── OCR（医嘱线；引擎由 M1-T11 实测定案，以下占位，定案后按所选服务补全）──
OCR_PROVIDER=
OCR_API_KEY=
OCR_BASE_URL=

# ── 其他开关 ──
# 医疗搜索默认关（PRD §7.5：仅本地说明书未命中才兜底，且标注"未经本库核实"）
ENABLE_MEDICAL_SEARCH=false
# 运行端口（默认 8787）
PORT=8787
