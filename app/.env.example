# 安心用药 · 环境变量示例（复制为 .env 后填真实值；.env 已 gitignore，勿提交真实凭据）

# ── PostgreSQL ──
# dev 库连接。测试库 anxin_medication_test 由此 URL 派生（仅换库名），
# 需 anxin 角色具备 CREATEDB 权限（T6 测试库基建）：ALTER ROLE anxin CREATEDB;
DATABASE_URL=postgresql://anxin:anxin_dev_2026@localhost:5432/anxin_medication

# ── Qwen3-VL（层检测 / 身份线提取；key 只在后端）──
QWEN_API_KEY=
QWEN_BASE_URL=

# ── 咨询文本链（P0 · docs/13 §3/§5.1：默认 qwen3.8-flash 非思考；deepseek 对照；baichuan 回滚）──
# CONSULT_PROVIDER: qwen | deepseek | baichuan；思考开关在客户端代码写死（R4），不设 env
CONSULT_PROVIDER=qwen
# 仅作用于 qwen 文本链的模型覆盖（缺省 qwen3.8-flash；deepseek 用 DEEPSEEK_MODEL）
CONSULT_MODEL=
# DeepSeek 对照档（仅 CONSULT_PROVIDER=deepseek 时 consultAnswer 走此链；fallbackParse/摘要仍走 qwen）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# ── Baichuan-M3-Plus（回滚通道：CONSULT_PROVIDER=baichuan 时启用；P0 前的默认咨询引擎）──
BAICHUAN_API_KEY=
BAICHUAN_BASE_URL=

# ── OCR（医嘱线；qwen3.5-ocr 云端 OpenAI 兼容端点，ADR #16 取代 #13 弃 PaddleOCR 自托管）──
# OCR_BASE_URL 为 OpenAI 兼容 base（如 https://dashscope.aliyuncs.com/compatible-mode/v1），
# 实际调用 POST {OCR_BASE_URL}/chat/completions；OCR_MODEL 默认 qwen3.5-ocr。
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=qwen3.5-ocr

# ── 其他开关 ──
# 运行端口（默认 8787）
PORT=8787

# ── 鉴权（G7 最小账号密码登录）──
# demo：注入演示用户 p-001（本地开发/测试/fixtures E2E 默认；缺省即 demo）；
# password：账号密码登录（受控验收/staging 必须用这个；公网部署不要留 demo）。
# 账号用 CLI 开通（不开放 HTTP 自助注册）：
#   pnpm --filter @anxin/api auth:create-user -- --username p-001 --id p-001
#   （省略 --password 会生成随机初始密码，仅显示一次）
AUTH_MODE=demo

# ── 手机号验证码登录/注册（P1 · 阿里云「号码认证服务 · 短信认证」）──
# 个人实名即可开通（免企业资质、免签名/模板报备），验证码由阿里云托管生成与核验（核验免费）。
# 控制台：赠送签名 https://dypns.console.aliyun.com/smsCertParamsConfig/sign
#        赠送模板 https://dypns.console.aliyun.com/smsCertParamsConfig/template（登录/注册=100001）
# 缺任一项时 /api/auth/phone/* 返回 503 SMS_NOT_CONFIGURED（fail-closed，不静默降级）。
# 自测：pnpm --filter @anxin/api sms:smoke -- --check 13800138000 --code 000000（免费，验 AK/权限）
DYPNS_ACCESS_KEY_ID=
DYPNS_ACCESS_KEY_SECRET=
DYPNS_SIGN_NAME=
DYPNS_TEMPLATE_LOGIN=100001
# 可选：找回密码模板（赠送 100003；P1 找回密码用，本期接口未开）
DYPNS_TEMPLATE_RESET=
# 同 IP 每小时发码上限（默认 10；同号 60 秒冷却固定，见 lib/auth/sms-rate-limit.ts）
SMS_IP_PER_HOUR=10
