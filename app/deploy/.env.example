# 安心用药 · 服务器 .env 模板（M5-T1）
#
# 用法：服务器上 `cp deploy/.env.example .env`（放在 app/ 目录、与 docker-compose.yml 同级），
#      填真实值后 `chmod 600 .env`。api 容器的运行期凭据由 compose 的 env_file 读这个文件注入——
#      **文件里没有的键就不会注入**（保持未定义，api 代码据此回落内置默认模型），所以用不到的行整行删掉即可。
# 纪律：真实 .env 只存在于服务器，**绝不进 git、不进镜像**（.gitignore 与 .dockerignore 均已排除）。
#      任何 key 都不写在这里以外的地方（deploy/README.md 里也不留真值）。

# ── 构建期：国内服务器走 npm 镜像，否则 deps 阶段 corepack/pnpm 会慢到超时 ──
# （这一行走 compose 变量插值，与上面的 env_file 注入是两条通道，都读这同一个文件）
NPM_REGISTRY=https://registry.npmmirror.com

# ── PostgreSQL 口令（唯一需要改的数据库项）──
# compose 里 db 服务的 POSTGRES_PASSWORD 与 api 的 DATABASE_URL 都插值自这一行，改一处即可。
# 生成：openssl rand -hex 24。⚠️ 改了口令且 pgdata 卷已有数据时，db 容器不会自动同步密码
#    （口令只在首次初始化时生效），需 `docker compose exec db psql -U anxin -c "alter role anxin with password '新口令'"`。
POSTGRES_PASSWORD=change-me-random

# ── 运行模式（正常部署留空 = 真实模型链路）──
# 只在跑 T1 的 e2e fixtures 验收时临时改成 fixtures（见 deploy/README.md §e2e 对火山跑一遍），跑完改回空并重启。
AI_MODE=

# ── 鉴权（G7 · 账号密码登录）──
# 受控验收/staging 必须 password（公网裸 IP 部署不能留 demo 旁路）；
# 旧 .env 没有该键时 docker-compose.yml 默认按 password fail-closed。
# 账号开通/重置（镜像内含 CLI，在服务器 app/ 目录执行）：
#   docker compose exec api node packages/api/dist/scripts/auth-create-user.js --username p-001 --id p-001 --name 张某某
#   docker compose exec api node packages/api/dist/scripts/auth-reset-password.js --username p-001
# 生成的初始密码只在命令输出里显示一次，立即记录以便交付演示账号。
# 本地开发/测试不需要本文件，缺省 = demo（注入 p-001 旁路，既有 E2E 不变）。
AUTH_MODE=password

# ── Qwen3-VL（层检测 / 身份线提取 / qwen 文本链；key 只在后端）──
QWEN_API_KEY=
QWEN_BASE_URL=
# 可选：留空则用代码内默认 qwen3-vl-plus
QWEN_MODEL=

# ── 咨询文本链（docs/13 §3/§5.1：默认 qwen3.8-flash 非思考；deepseek 对照；baichuan 回滚）──
# CONSULT_PROVIDER: qwen | deepseek | baichuan
CONSULT_PROVIDER=qwen
# 仅作用于 qwen 文本链的模型覆盖（缺省 qwen3.8-flash）
CONSULT_MODEL=
# DeepSeek 对照档（仅 CONSULT_PROVIDER=deepseek 时生效）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Baichuan-M3-Plus（回滚通道）
BAICHUAN_API_KEY=
BAICHUAN_BASE_URL=
BAICHUAN_MODEL=

# ── OCR（医嘱线；qwen3.5-ocr 云端 OpenAI 兼容端点，ADR #16）──
# OCR_BASE_URL 为 OpenAI 兼容 base（如 https://dashscope.aliyuncs.com/compatible-mode/v1）
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=qwen3.5-ocr

# ── 咨询行为开关（都留空即维持默认：意图路由开、医疗搜索关）──
# ENABLE_INTENT_ROUTE=false 可整体回滚意图路由
ENABLE_INTENT_ROUTE=
ENABLE_MEDICAL_SEARCH=

# ── 可观测性（G10：错误日志 + 模型调用计数 + 日预算告警 + 限流）──
# 说明与运维命令见 deploy/README.md §9.4；日志/指标落盘目录由 docker-compose 固定为 /app/logs
# （宿主机 app/logs 挂载持久化，已 .gitignore；无需在 .env 配 LOG_DIR）。
#
# 观测端点管理 token：GET /api/observability/summary 需带请求头 x-obs-token。
# 生成：openssl rand -hex 24。⚠️ 未设置时该端点返回 404（不暴露端点存在性）；
# 设置后错误 token → 401。仅在服务器 .env 配，不写入代码/客户端。
OBS_ADMIN_TOKEN=
#
# 日模型预算（CNY，默认 20）：按当日 usage tokens × 单价估算成本；
# 达到 80% / 100% 各 console.warn 一次 [obs:budget]（每档每天一次，重启从当日指标文件恢复不重复）。
LLM_DAILY_BUDGET_CNY=20
# 单价（CNY / 百万 tokens；默认值即百炼价目：输入 0.8 / 输出 2.7 / 缓存命中 0.1）。
# 成本 = 未缓存输入×输入价 + 缓存命中×缓存价 + 输出×输出价；以控制台账单为准（此为估算口径）。
LLM_PRICE_INPUT_CNY_PER_M=0.8
LLM_PRICE_OUTPUT_CNY_PER_M=2.7
LLM_PRICE_CACHED_CNY_PER_M=0.1
#
# 限流（单实例内存滑动窗口；超限 429 RATE_LIMITED + Retry-After，见 README §9.4）：
# LLM 路由按 userId：RL_LLM_PER_MIN=10（默认，每分钟）、RL_LLM_PER_DAY=200（默认，24h 滚动）；
# IP 兜底：RL_IP_PER_MIN=240（默认，/api/health 豁免）。调大前先评估模型并发与成本。
RL_LLM_PER_MIN=10
RL_LLM_PER_DAY=200
RL_IP_PER_MIN=240
