# 安心用药 · 服务器 .env 模板（M5-T1）
#
# 用法：服务器上 `cp deploy/.env.example .env`（放在 app/ 目录、与 docker-compose.yml 同级），
#      填真实值后 `chmod 600 .env`。docker-compose.yml 的运行期变量全部插值自这个文件。
# 纪律：真实 .env 只存在于服务器，**绝不进 git、不进镜像**（.gitignore 与 .dockerignore 均已排除）。
#      任何 key 都不写在这里以外的地方（deploy/README.md 里也不留真值）。

# ── 构建期：国内服务器走 npm 镜像，否则 deps 阶段 corepack/pnpm 会慢到超时 ──
NPM_REGISTRY=https://registry.npmmirror.com

# ── PostgreSQL 口令（唯一需要改的数据库项）──
# compose 里 db 服务的 POSTGRES_PASSWORD 与 api 的 DATABASE_URL 都插值自这一行，改一处即可。
# 生成：openssl rand -hex 24。⚠️ 改了口令且 pgdata 卷已有数据时，db 容器不会自动同步密码
#    （口令只在首次初始化时生效），需 `docker compose exec db psql -U anxin -c "alter role anxin with password '新口令'"`。
POSTGRES_PASSWORD=change-me-random

# ── 运行模式（正常部署留空 = 真实模型链路）──
# 只在跑 T1 的 e2e fixtures 验收时临时改成 fixtures（见 deploy/README.md §e2e 对火山跑一遍），跑完改回空并重启。
AI_MODE=

# ── Qwen3-VL（层检测 / 身份线提取 / qwen 文本链；key 只在后端）──
QWEN_API_KEY=
QWEN_BASE_URL=
# 可选：留空则用代码内默认 qwen3-vl-plus
QWEN_MODEL=

# ── 咨询文本链（docs/13 §3/§5.1：默认 qwen3.8-flash 非思考；deepseek 对照；baichuan 回滚）──
# CONSULT_PROVIDER: qwen | deepseek | baichuan
CONSULT_PROVIDER=qwen
# 仅作用于 qwen 文本链的模型覆盖（缺省 qwen3.8-flash）
CONSULT_MODEL=
# DeepSeek 对照档（仅 CONSULT_PROVIDER=deepseek 时生效）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Baichuan-M3-Plus（回滚通道）
BAICHUAN_API_KEY=
BAICHUAN_BASE_URL=
BAICHUAN_MODEL=

# ── OCR（医嘱线；qwen3.5-ocr 云端 OpenAI 兼容端点，ADR #16）──
# OCR_BASE_URL 为 OpenAI 兼容 base（如 https://dashscope.aliyuncs.com/compatible-mode/v1）
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=qwen3.5-ocr

# ── 咨询行为开关（都留空即维持默认：意图路由开、医疗搜索关）──
# ENABLE_INTENT_ROUTE=false 可整体回滚意图路由
ENABLE_INTENT_ROUTE=
ENABLE_MEDICAL_SEARCH=
