{
  "name": "@anxin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "esbuild src/index.ts src/scripts/auth-create-user.ts src/scripts/auth-reset-password.ts src/scripts/sms-smoke.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist --outbase=src --external:postgres --external:drizzle-orm --external:hono --external:@hono/node-server --external:@hono/zod-validator --external:dotenv --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-users": "tsx src/db/seed-users.ts",
    "db:seed-interaction-rules": "tsx src/db/seed-interaction-rules.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "db:seed-drafts": "tsx src/db/seed-drafts-demo.ts",
    "db:import-crawled": "tsx src/db/import-crawled.ts",
    "db:import-manuals": "tsx src/db/import-manuals.ts",
    "db:review-export": "tsx src/scripts/review-export.ts",
    "db:review-apply": "tsx src/scripts/review-apply.ts",
    "db:backfill-dxy-sections": "tsx src/scripts/backfill-dxy-sections.ts",
    "db:review-dxy-check": "tsx src/scripts/review-dxy-check.ts",
    "db:coverage-m8": "tsx src/scripts/m8-coverage.ts",
    "db:interaction-coverage": "tsx src/scripts/interaction-coverage.ts",
    "db:cleanup-demo-drugs": "tsx src/scripts/cleanup-demo-drugs.ts",
    "db:rule-candidates": "tsx src/scripts/rule-candidates.ts",
    "db:rule-signoff-sheet": "tsx src/scripts/rule-signoff-sheet.ts",
    "db:rule-signoff-import": "tsx src/scripts/rule-signoff-import.ts",
    "db:rule-signoff-import-batch2": "tsx src/scripts/rule-signoff-import-batch2.ts",
    "db:rule-signoff-import-batch3": "tsx src/scripts/rule-signoff-import-batch3.ts",
    "db:pharmacist-packet": "tsx src/scripts/pharmacist-packet.ts",
    "db:pharmacist-review-import": "tsx src/scripts/pharmacist-review-import.ts",
    "db:repair-specs": "tsx src/scripts/repair-specs.ts",
    "db:repair-manuals": "tsx src/scripts/repair-manuals.ts",
    "db:audit": "tsx src/db/data-audit.ts",
    "perf:intake": "tsx src/scripts/perf-intake.ts",
    "eval:export-labels": "tsx src/scripts/export-consult-labels.ts",
    "eval:intent": "tsx src/scripts/eval-consult-intent.ts",
    "perf:consult": "tsx src/scripts/perf-consult.ts",
    "perf:consult-live": "tsx src/scripts/perf-consult-live.ts",
    "db:studio": "drizzle-kit studio",
    "auth:create-user": "tsx src/scripts/auth-create-user.ts",
    "auth:reset-password": "tsx src/scripts/auth-reset-password.ts",
    "sms:smoke": "tsx src/scripts/sms-smoke.ts",
    "eval:record-consult-fixtures": "tsx src/scripts/record-consult-fixtures.ts",
    "eval:consult-bakeoff": "tsx src/scripts/consult-bakeoff.ts"
  },
  "dependencies": {
    "@anxin/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
