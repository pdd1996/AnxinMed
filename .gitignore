# ── 环境变量（真实 key 只进 .env，永不入库；保留示例）──
.env
.env.*
!.env.example

# ── 依赖 ──
node_modules/

# ── 构建产物 ──
dist/
build/
*.tsbuildinfo

# ── 包管理器：本仓库用 pnpm，忽略 npm / yarn 锁文件（保留 pnpm-lock.yaml）──
package-lock.json
yarn.lock

# ── 编辑器 / 工具 / 系统 ──
.qoder/
.DS_Store
Thumbs.db
*.log

# ── Playwright E2E 产物（M2-T10）──
test-results/
playwright-report/
blob-report/
playwright/.cache/
app/e2e/shot-*.png

# ── demo：嵌套 git 仓库，只读迁移参照物，不纳入本仓库跟踪（保留其独立历史）──
demo/
