# ── 环境变量（真实 key 只进 .env，永不入库；保留示例）──
.env
.env.*
!.env.example

# ── 依赖 ──
node_modules/

# ── 构建产物 ──
dist/
build/
*.tsbuildinfo

# ── 数据库备份 dump（M5-T1：真实数据落盘处，永不入库）──
app/backups/
*.dump

# ── 包管理器：本仓库用 pnpm，忽略 npm / yarn 锁文件（保留 pnpm-lock.yaml）──
package-lock.json
yarn.lock

# ── 编辑器 / 工具 / 系统 ──
.qoder/
.DS_Store
Thumbs.db
*.log

# ── Playwright E2E 产物（M2-T10）──
test-results/
playwright-report/
blob-report/
playwright/.cache/
app/e2e/shot-*.png

# ── demo：嵌套 git 仓库，只读迁移参照物，不纳入本仓库跟踪（保留其独立历史）──
demo/

.zcode/

gui-test-screenshots/
# ── 爬虫工具与数据（含登录凭证，永不入库；内容版权归丁香园，见 PRD §13.1/§14）──
tools/drug-crawler/
data/crawled/
data/manuals/
data/manuals-manifest*.json*
data/category-manifests/
data/import-log.jsonl
data/crawled-总账.md
data/manuals-总账.md

# Python 缓存（tools/manual-pdf）
__pycache__/
*.pyc

# 对打明细（模型输出引用说明书原文，DXY 版权纪律不入库；summary.md 保留）
data/consult-bakeoff/*.json

# M6 分批导入暂存（草稿导入后并入 data/manuals）
data/manuals-incoming/
data/manuals-*.csv

# M6 人工核对批次产物（含 PDF 页图，不入库）
data/review-batches/

# M6 人工判定回收（审核页导出的 decisions/verdicts，含说明书正文，不入库）
data/review-manual/

# M7 重提取中间产物 / 差异与质量报告 / 基线哈希（含说明书正文，不入库）
data/manuals-incoming-m7/
data/m7-reports/
data/m7-baseline.json

# M8 上线前收口：基线 / 规则候选账本 / 覆盖报告 / reviewed 队列（含说明书正文与来源引用，不入库）
data/m8-reports/

# M9 模拟准备：基线 / 清理报告 / 规则候选池（含说明书正文，不入库）
data/m9-reports/

# ── 药方样张：处方笺图片一律不入库（2026-11-12 口径；图片留本地，脚本可重建）──
# 生成方式：python app/fixtures/make-fixtures.py（带字，Pillow）/ python tools/ocr-bench/make_sample.py
# CI 缺图由 e2e/scripts/make-sample-images.ts 在 globalSetup 补纯色占位图（回放不读像素）
app/fixtures/rx-*.png
tools/ocr-bench/sample-prescription.png
